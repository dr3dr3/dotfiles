#!/usr/bin/env bash
# herdr-autosnap — keep a recent Herdr snapshot on disk at all times.
#
# herdr-snapshot is excellent insurance and, until now, was only ever fired by
# `devrebuild` — i.e. exactly and only on the ONE failure mode we control. The
# failures we do not control (host reboot for an OS update, Docker Desktop
# restart, OOM kill, laptop lid) leave no snapshot at all, and the fallback
# underneath it — Herdr's own session.json — is itself destroyed by a clean
# shutdown (see herdr-session-guard). On 2026-09-23 that combination cost a
# 41-pane, 31-session workspace, which had to be reconstructed by hand from
# transcript mtimes and the server log.
#
# So: snapshot on a timer, not on an event we have to remember to trigger.
#
# Cheap by design — it only writes when the layout actually CHANGED since the
# last snapshot (same panes + same agent session ids => no write), so an idle
# workspace does not churn the ring buffer and the retained history covers real
# working time rather than the last N minutes.
#
#   herdr-autosnap start     # background daemon (safe to call repeatedly)
#   herdr-autosnap stop
#   herdr-autosnap status
#   herdr-autosnap once      # single check, used by the daemon loop
#
# Tunables: HERDR_AUTOSNAP_INTERVAL (seconds, default 300)
#           HERDR_SNAPSHOT_KEEP     (passed through to herdr-snapshot)
set -euo pipefail

DIR="${XDG_CONFIG_HOME:-$HOME/.config}/herdr"
SNAPS="$DIR/snapshots"
PIDFILE="$DIR/autosnap.pid"
LOG="$DIR/autosnap.log"
STATE="$DIR/autosnap.digest"
INTERVAL="${HERDR_AUTOSNAP_INTERVAL:-300}"
# Deeper ring than a hand-run herdr-snapshot: this fires on every layout change,
# so 20 would cover only an hour of busy work. 60 pairs is a few MB.
export HERDR_SNAPSHOT_KEEP="${HERDR_SNAPSHOT_KEEP:-60}"

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"; }

server_up() { herdr status server >/dev/null 2>&1 && herdr status 2>/dev/null | grep -q 'status: running'; }

# A digest of what we would actually want back: which panes exist, in which
# tabs, and which agent session id each one holds. Deliberately NOT the whole
# snapshot — cwd, focus, scroll offsets and timestamps all churn constantly and
# would make every tick look like a change.
digest() {
  herdr api snapshot 2>/dev/null | jq -S -c '
    .result.snapshot
    | {panes: [.panes[]? | {pane_id, tab_id}] | sort,
       agents: [.agents[]? | {pane_id, sid: .agent_session.value}] | sort}
  ' 2>/dev/null || true
}

once() {
  server_up || { log "skip: no herdr server"; return 0; }
  local d prev
  d="$(digest)"
  [ -n "$d" ] && [ "$d" != "null" ] || { log "skip: could not read snapshot"; return 0; }
  prev="$(cat "$STATE" 2>/dev/null || true)"
  if [ "$d" = "$prev" ]; then
    return 0
  fi
  if out="$(herdr-snapshot 2>&1)"; then
    printf '%s' "$d" >"$STATE"
    log "snapshot: $out"
  else
    log "snapshot FAILED: $out"
  fi
}

running() {
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

case "${1:-start}" in
  once) once ;;
  status)
    if running; then echo "herdr-autosnap: running (pid $(cat "$PIDFILE"), every ${INTERVAL}s)";
    else echo "herdr-autosnap: not running"; fi
    echo "snapshots: $(ls -1 "$SNAPS"/*.json 2>/dev/null | grep -vc '\.session\.json$' || echo 0) in $SNAPS"
    [ -f "$LOG" ] && tail -3 "$LOG" || true
    ;;
  stop)
    if running; then kill "$(cat "$PIDFILE")" 2>/dev/null || true; rm -f "$PIDFILE"; echo "stopped"; else echo "not running"; fi
    ;;
  start)
    install -d -m 0700 "$DIR" "$SNAPS"
    if running; then echo "herdr-autosnap: already running (pid $(cat "$PIDFILE"))"; exit 0; fi
    command -v herdr >/dev/null || { echo "herdr-autosnap: herdr not on PATH" >&2; exit 1; }
    command -v jq    >/dev/null || { echo "herdr-autosnap: jq required" >&2; exit 1; }
    # setsid so the loop is not in the process group of whatever started it
    # (postStartCommand, a login shell, a pane) and does not die with it.
    setsid bash -c '
      echo $$ > "'"$PIDFILE"'"
      trap "rm -f \"'"$PIDFILE"'\"" EXIT
      while true; do
        "'"$0"'" once || true
        sleep "'"$INTERVAL"'"
      done
    ' >/dev/null 2>&1 &
    sleep 0.2
    log "started (interval ${INTERVAL}s)"
    echo "herdr-autosnap: started (every ${INTERVAL}s, snapshots in $SNAPS)"
    ;;
  *) echo "usage: herdr-autosnap [start|stop|status|once]" >&2; exit 2 ;;
esac
