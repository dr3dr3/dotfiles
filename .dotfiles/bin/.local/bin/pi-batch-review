#!/usr/bin/env bash
# =============================================================================
# pi-batch-review — what did the overnight agent runs actually do?
#
# One command in the morning: what ran, whether to trust it, what to do next.
#
# Usage:
#   pi-batch-review                 # table of recent runs
#   pi-batch-review <stamp>         # one run in full, with its diff
#   pi-batch-review --failed        # only runs that need attention
#   pi-batch-review --prune         # delete records past the retention window
#
# -----------------------------------------------------------------------------
# "OUTSTANDING" MEANS THE BRANCH STILL EXISTS
#
# There is no "mark as reviewed" flag, deliberately. The pi-batch/<stamp> branch
# IS the thing you have to act on, so merging or deleting it is the review, and
# a branch cannot drift from reality the way a flag file can. Same reasoning as
# doctor-mac.sh: assert the machine, do not track intent.
#
# Reviewed something but want to keep the code? Rename it off the prefix —
#   git branch -m pi-batch/20260916-0300 parked/experiment
# It drops out of "outstanding" while staying one source of truth.
#
# Branch state needs the container, so when it is not running this reports the
# records alone and says the branch state is unknown rather than guessing.
# =============================================================================
set -uo pipefail

LOG_DIR="${PI_BATCH_LOG_DIR:-$HOME/.local/state/pi-batch}"
RETENTION_DAYS="${PI_BATCH_RETENTION_DAYS:-30}"
MODE="list"; WANT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --failed)  MODE="failed"; shift ;;
    --prune)   MODE="prune"; shift ;;
    -h|--help) sed -n '2,12p' "${BASH_SOURCE[0]}"; exit 0 ;;
    -*)        echo "Unknown option: $1 (try --help)" >&2; exit 2 ;;
    *)         MODE="show"; WANT="$1"; shift ;;
  esac
done

ok()   { printf '\033[1;32m  ✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m  !\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m  ✗\033[0m %s\n' "$*" >&2; exit 1; }

[[ -d "$LOG_DIR" ]] || die "No run records yet at $LOG_DIR (nothing has run)."
records=$(find "$LOG_DIR" -maxdepth 1 -name '*.json' 2>/dev/null | sort)
[[ -n "$records" ]] || die "No run records in $LOG_DIR."

# Ask the container whether a branch is still there. Empty answer = unknown.
branch_state() { # $1 container  $2 workdir  $3 branch
  docker exec -w "$2" "$1" git rev-parse --verify --quiet "refs/heads/$3" 2>/dev/null \
    | tr -d '\r' | head -1
}

# --- prune -------------------------------------------------------------------
# Only removes records whose branch is CONFIRMED gone. A run we cannot check, or
# whose branch survives, is never pruned however old — the whole point is not to
# lose track of work that was never reviewed.
if [[ "$MODE" == "prune" ]]; then
  cutoff=$(( $(date +%s) - RETENTION_DAYS*86400 ))
  pruned=0; kept=0
  for rec in $records; do
    read -r stamp container workdir branch < <(/usr/bin/python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
print(d["stamp"], d["container"], d["workdir"], d["batch_branch"])' "$rec")
    ts=$(date -j -f "%Y%m%d-%H%M%S" "$stamp" +%s 2>/dev/null || echo 0)
    if [[ "$ts" -eq 0 || "$ts" -ge "$cutoff" ]]; then kept=$((kept+1)); continue; fi
    if ! docker inspect "$container" >/dev/null 2>&1; then
      warn "$stamp: container '$container' gone — cannot confirm the branch, keeping"
      kept=$((kept+1)); continue
    fi
    if [[ -n "$(branch_state "$container" "$workdir" "$branch")" ]]; then
      warn "$stamp: branch $branch still exists — keeping (review it first)"
      kept=$((kept+1)); continue
    fi
    rm -f "$rec" "${rec%.json}.log"; pruned=$((pruned+1))
  done
  ok "pruned $pruned record(s) older than ${RETENTION_DAYS}d; kept $kept"
  exit 0
fi

# --- one run in detail -------------------------------------------------------
if [[ "$MODE" == "show" ]]; then
  rec="$LOG_DIR/$WANT.json"
  [[ -f "$rec" ]] || die "No record for '$WANT'. Run \`pi-batch-review\` to list them."
  /usr/bin/python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
print("  run        %s" % d["stamp"])
print("  model      %s   (thinking: %s)" % (d["model"], d["thinking"]))
print("  where      %s : %s" % (d["container"], d["workdir"]))
print("  base       %s @ %s" % (d["base_branch"], d["base_sha"][:8]))
print("  branch     %s" % d["batch_branch"])
print("  brief      %s" % d["brief"])
print("  agent      exit %s in %ss" % (d["agent_exit"], d["elapsed_s"]))
print("  tests      %s -> %s   (%s)" % (d["baseline"], d["verdict"], d["test_cmd"] or "no gate"))
ds=d["diffstat"]
print("  diff       %s file(s), +%s/-%s" % (ds["files"], ds["insertions"], ds["deletions"]))
print("  commits    %d" % len(d["commits"]))
for c in d["commits"]:
    print("             %s %s" % (c["sha"][:8], c["subject"]))
print("  log        %s" % d["log"])
print("  session    pi --resume   (%s)" % d["session"])
' "$rec"
  read -r container workdir branch base < <(/usr/bin/python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
print(d["container"], d["workdir"], d["batch_branch"], d["base_sha"])' "$rec")
  echo
  if docker inspect "$container" >/dev/null 2>&1 && [[ -n "$(branch_state "$container" "$workdir" "$branch")" ]]; then
    echo "  --- diff ---"
    docker exec -w "$workdir" "$container" git diff --stat "$base".."$branch" 2>/dev/null | sed 's/^/  /'
    echo
    echo "  Read it:  docker exec -w $workdir $container git log $base..$branch -p"
    echo "  Keep it:  docker exec -w $workdir $container git merge $branch"
    echo "  Drop it:  docker exec -w $workdir $container git branch -D $branch"
  else
    echo "  (branch gone or container down — this run is already dealt with)"
  fi
  exit 0
fi

# --- the table ---------------------------------------------------------------
printf '  %-15s %-26s %5s %4s %-9s %s\n' WHEN MODEL TIME CMTS TESTS BRANCH
outstanding=0
for rec in $records; do
  read -r stamp model elapsed ncommits verdict container workdir branch < <(/usr/bin/python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
print(d["stamp"], d["model"], d["elapsed_s"], len(d["commits"]),
      d["verdict"].split()[0], d["container"], d["workdir"], d["batch_branch"])' "$rec")
  [[ "$MODE" == "failed" && "$verdict" != "FAIL" ]] && continue

  state="reviewed"
  if docker inspect "$container" >/dev/null 2>&1; then
    [[ -n "$(branch_state "$container" "$workdir" "$branch")" ]] && { state="$branch"; outstanding=$((outstanding+1)); }
  else
    state="? (container down)"
  fi
  # Colour the verdict but pad the PLAIN text: escape codes count toward a
  # printf width, so padding the coloured string misaligns every later column.
  case "$verdict" in
    PASS) c=$'\033[1;32m' ;;
    FAIL) c=$'\033[1;31m' ;;
    *)    c=$'\033[1;33m'; verdict="none" ;;
  esac
  printf '  %-15s %-26s %4ss %4s %s%-5s%s %s\n' \
    "$stamp" "${model:0:26}" "$elapsed" "$ncommits" "$c" "$verdict" $'\033[0m' "$state"
done
echo
if [[ "$outstanding" -gt 0 ]]; then
  warn "$outstanding run(s) outstanding — their branches still exist"
  echo "      pi-batch-review <stamp>   to see one"
else
  ok "nothing outstanding"
fi
