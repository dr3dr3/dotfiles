#!/usr/bin/env bash
# =============================================================================
# ~/.local/bin/hostchrome — let an agent in the devcontainer drive a Chrome on
# the host machine, in a window you can watch and take over.
# (stow package: bin; linked into the container by scripts/setup-devcontainer.sh)
#
# One script, three sides (picked automatically; HOSTCHROME_SIDE=mac|linux|container
# overrides):
#
#   Mac / Linux host:  hostchrome [start [url]]   launch (or reuse) the agent Chrome
#                      hostchrome stop            quit it (and the Linux relays)
#                      hostchrome status
#                      hostchrome firewall        Linux: the ufw rules the relay needs
#
#   Container:         hostchrome status          can the container reach it?
#                      hostchrome url             print the CDP URL
#                      hostchrome open <url>      open a tab for the human
#                      hostchrome axi <args...>   chrome-devtools-axi against it,
#                                                 e.g. hostchrome axi open http://localhost:8080
#                      hostchrome stop            drop the container-port forwards
#                      roe-browser-open <url>     $BROWSER shim (symlink to this script)
#
#   localhost URLs: published stack ports pass through; container-only ports are
#   forwarded onto the container IP and the URL rewritten (see reach_url).
#
# Why it is shaped like this:
#   - A separate profile (--user-data-dir). Chrome 136+ ignores
#     --remote-debugging-port on the default profile, and anything that can
#     reach the port has full control of the profile — so it is one with no
#     personal logins in it. Your everyday browser is untouched.
#   - Loopback only. Chrome honours --remote-debugging-address only in headless
#     mode, so the port is always 127.0.0.1 on the host. How the container gets
#     in differs:
#       Mac (OrbStack): host.docker.internal is forwarded to Mac loopback
#         (verified 2026-09-30, Chrome 154). Docker Desktop may not do this.
#       Linux (Omarchy, native Docker): nothing forwards to loopback, so start
#         runs a socat relay on each Docker bridge address (docker0, br-*) —
#         reachable from containers, not from the LAN. ufw's default-deny then
#         drops the container's connection until `hostchrome firewall`'s rules
#         are added.
#   - IP, not hostname. The DevTools HTTP endpoint rejects a Host header that is
#     not an IP or "localhost" (a DNS-rebinding guard), so the container side
#     resolves the host to an IPv4 address first: host.docker.internal when it
#     exists, else the container's default gateway (a bridge address — one the
#     Linux relay listens on).
#   - A named axi session ("host"). chrome-devtools-axi's default session keeps
#     launching its own headless Chrome, so unattended workers are unaffected.
#   - The same URLs on both sides. The stack's published ports (8080, 8081, …)
#     are on the host's localhost, so a URL you paste and a URL the agent opens
#     mean the same thing.
# =============================================================================
set -euo pipefail

port="${HOSTCHROME_PORT:-9222}"
profile="${HOSTCHROME_PROFILE:-$HOME/.chrome-roe-agent}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hostchrome"

die() { echo "hostchrome: $*" >&2; exit 1; }

cdp_version() { curl -fsS -m 3 "http://$1:$port/json/version" 2>/dev/null; }

side() {
  if [[ -n "${HOSTCHROME_SIDE:-}" ]]; then echo "$HOSTCHROME_SIDE"
  elif [[ -e /.dockerenv || -e /run/.containerenv ]]; then echo container
  elif [[ "$(uname -s)" == Darwin ]]; then echo mac
  else echo linux
  fi
}

open_tab() {
  # Opens in the agent Chrome specifically — a desktop "open" would pick your everyday one.
  curl -fsS -m 3 -X PUT "http://127.0.0.1:$port/json/new?$1" >/dev/null ||
    die "could not open $1 in the agent Chrome"
}

wait_for_cdp() {
  local _
  for _ in $(seq 1 30); do
    if cdp_version 127.0.0.1 >/dev/null; then
      echo "hostchrome: agent Chrome ready on 127.0.0.1:$port (profile $profile)"
      return 0
    fi
    sleep 0.5
  done
  die "Chrome started but port $port never answered — is something else holding it? (ss -ltnp / lsof -iTCP:$port)"
}

host_status() {
  local v
  if v="$(cdp_version 127.0.0.1)"; then
    echo "hostchrome: listening on 127.0.0.1:$port"
    printf '%s\n' "$v" | grep -E '"Browser"' || true
  else
    echo "hostchrome: not running — start it with: hostchrome"
    return 1
  fi
}

stop_chrome() {
  if pkill -f -- "--user-data-dir=$profile"; then echo "hostchrome: Chrome stopped"
  else echo "hostchrome: Chrome not running"; fi
}

# --- Mac ---------------------------------------------------------------------
mac_start() {
  local url="${1:-}" app="${HOSTCHROME_APP:-Google Chrome}"
  if cdp_version 127.0.0.1 >/dev/null; then
    echo "hostchrome: agent Chrome already listening on 127.0.0.1:$port"
    if [[ -n "$url" ]]; then open_tab "$url"; fi
    return 0
  fi
  open -Ra "$app" 2>/dev/null || die "'$app' is not installed (set HOSTCHROME_APP to another Chromium browser)"
  mkdir -p "$profile"
  # -n: a new instance even when your everyday Chrome is running.
  open -na "$app" --args \
    --remote-debugging-port="$port" \
    --user-data-dir="$profile" \
    --no-first-run --no-default-browser-check \
    ${url:+"$url"}
  wait_for_cdp
}

# --- Linux host --------------------------------------------------------------

# "<iface> <network/prefix> <address>" for each Docker bridge (docker0, br-*).
bridges() {
  ip -4 route show proto kernel scope link 2>/dev/null | awk '
    { dev = ""; src = ""
      for (i = 1; i <= NF; i++) { if ($i == "dev") dev = $(i + 1); if ($i == "src") src = $(i + 1) }
      if ((dev == "docker0" || dev ~ /^br-/) && src != "") print dev, $1, src }'
}

relay_alive() {
  local pid
  pid="$(cat "$1" 2>/dev/null)" || return 1
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && grep -q socat "/proc/$pid/cmdline" 2>/dev/null
}

start_relays() {
  command -v socat >/dev/null || die "socat is not installed (omarchy pkg add socat)"
  mkdir -p "$state_dir"
  local dev net addr pidfile n=0
  while read -r dev net addr; do
    [[ -n "$addr" ]] || continue
    pidfile="$state_dir/relay-$addr.pid"
    if relay_alive "$pidfile"; then n=$((n + 1)); continue; fi
    # No job control in a script, so the background child is not a process-group
    # leader: setsid execs socat in place and $! is socat's own pid.
    nohup setsid socat "TCP-LISTEN:$port,bind=$addr,reuseaddr,fork" "TCP:127.0.0.1:$port" \
      >>"$state_dir/relay.log" 2>&1 </dev/null &
    echo $! >"$pidfile"
    n=$((n + 1))
    echo "hostchrome: relay $addr:$port -> 127.0.0.1:$port ($dev $net)"
  done < <(bridges)
  [[ $n -gt 0 ]] || die "no Docker bridge found (docker0 / br-*) — is Docker running?"
  if command -v ufw >/dev/null && systemctl is-active --quiet ufw 2>/dev/null; then
    echo "hostchrome: ufw is active — if the container cannot connect, add the rules from: hostchrome firewall"
  fi
}

stop_relays() {
  local f pid n
  for f in "$state_dir"/relay-*.pid; do
    [[ -e "$f" ]] || continue
    if relay_alive "$f"; then
      pid="$(cat "$f")"; kill "$pid" && { n="${f##*/relay-}"; echo "hostchrome: relay ${n%.pid} stopped"; }
    fi
    rm -f "$f"
  done
}

linux_firewall() {
  local dev net addr
  echo "# Let containers on each Docker bridge reach the relay on that bridge's own address only:"
  while read -r dev net addr; do
    [[ -n "$addr" ]] && echo "sudo ufw allow in on $dev from $net to $addr port $port proto tcp comment 'hostchrome'"
  done < <(bridges)
}

linux_start() {
  local url="${1:-}" bin="" b
  if cdp_version 127.0.0.1 >/dev/null; then
    echo "hostchrome: agent Chrome already listening on 127.0.0.1:$port"
    if [[ -n "$url" ]]; then open_tab "$url"; fi
  else
    for b in "${HOSTCHROME_BROWSER:-}" chromium google-chrome-stable google-chrome chromium-browser; do
      if [[ -n "$b" ]] && command -v "$b" >/dev/null; then bin="$b"; break; fi
    done
    [[ -n "$bin" ]] || die "no Chromium/Chrome found (set HOSTCHROME_BROWSER)"
    mkdir -p "$profile" "$state_dir"
    # Arch's chromium wrapper still reads ~/.config/chromium-flags.conf (Omarchy's Wayland flags).
    nohup setsid "$bin" \
      --remote-debugging-port="$port" \
      --user-data-dir="$profile" \
      --no-first-run --no-default-browser-check \
      ${url:+"$url"} >>"$state_dir/chrome.log" 2>&1 </dev/null &
    wait_for_cdp
  fi
  start_relays
}

# --- Container ---------------------------------------------------------------
host_ip() {
  local ip="${HOSTCHROME_HOST:-}" g
  if [[ -z "$ip" ]]; then
    ip="$(getent ahostsv4 host.docker.internal 2>/dev/null | awk 'NR == 1 { print $1 }')"
  fi
  if [[ -z "$ip" ]]; then
    # Default gateway = this network's bridge address on the host.
    # /proc/net/route holds it as little-endian hex.
    g="$(awk 'NR > 1 && $2 == "00000000" { print $3; exit }' /proc/net/route 2>/dev/null)"
    if [[ ${#g} -eq 8 ]]; then
      ip="$((16#${g:6:2})).$((16#${g:4:2})).$((16#${g:2:2})).$((16#${g:0:2}))"
    fi
  fi
  [[ -n "$ip" ]] || die "cannot find the host's address (set HOSTCHROME_HOST)"
  printf '%s\n' "$ip"
}

cdp_url() { printf 'http://%s:%s\n' "$(host_ip)" "$port"; }

container_status() {
  local ip v
  ip="$(host_ip)"
  if v="$(cdp_version "$ip")"; then
    echo "hostchrome: reachable at http://$ip:$port"
    printf '%s\n' "$v" | grep -E '"Browser"' || true
  else
    echo "hostchrome: nothing answering at http://$ip:$port — run 'hostchrome' on the host first (on Linux, also check 'hostchrome firewall')" >&2
    return 1
  fi
}

# A localhost URL means the CONTAINER's loopback to the agent but the HOST's to
# the browser. Ports the stack publishes (8080, 8011, …) exist on both, so those
# pass through. Anything else (lavish, impeccable live, a Vite dev server) only
# exists in here: forward it onto the container's own IP — which OrbStack and a
# Linux host both route to — and rewrite the URL to that IP.
container_ip() {
  local ip="${HOSTCHROME_CONTAINER_IP:-}"
  [[ -n "$ip" ]] || ip="$(hostname -I 2>/dev/null | awk '{ print $1 }')"
  [[ -n "$ip" ]] || die "cannot find this container's IP (set HOSTCHROME_CONTAINER_IP)"
  printf '%s\n' "$ip"
}

published_on_host() {
  docker ps --format '{{.Ports}}' 2>/dev/null | tr ',' '\n' |
    sed -nE 's/^ *(0\.0\.0\.0|\[::\]|127\.0\.0\.1):([0-9]+)->.*/\2/p' | grep -qx "$1"
}

# Already listening on all addresses (or on the container IP)? Then no forward is needed.
listens_wide() {
  local hex cip_hex
  hex="$(printf '%04X' "$1")"
  # shellcheck disable=SC2046  # word-split the four octets on purpose
  cip_hex="$(printf '%02X' $(echo "$2" | tr '.' ' ') | sed -E 's/(..)(..)(..)(..)/\4\3\2\1/')"
  awk -v a="00000000:$hex" -v b="$cip_hex:$hex" 'NR > 1 && $4 == "0A" && ($2 == a || $2 == b) { f = 1 } END { exit !f }' /proc/net/tcp ||
    awk -v a="00000000000000000000000000000000:$hex" 'NR > 1 && $4 == "0A" && $2 == a { f = 1 } END { exit !f }' /proc/net/tcp6 2>/dev/null
}

ensure_forward() {
  local p="$1" cip="$2" pidfile="$state_dir/fwd-$1.pid"
  relay_alive "$pidfile" && return 0
  command -v socat >/dev/null || die "socat is not installed in the container"
  mkdir -p "$state_dir"
  nohup setsid socat "TCP-LISTEN:$p,bind=$cip,reuseaddr,fork" "TCP:127.0.0.1:$p" \
    >>"$state_dir/forward.log" 2>&1 </dev/null &
  echo $! >"$pidfile"
  sleep 0.3
  relay_alive "$pidfile" || die "could not forward $cip:$p (see $state_dir/forward.log)"
  echo "hostchrome: forwarding $cip:$p -> container 127.0.0.1:$p" >&2
}

reach_url() {
  local url="$1" re='^([hH][tT][tT][pP][sS]?)://(localhost|127\.0\.0\.1|0\.0\.0\.0|\[::1\])(:([0-9]+))?(.*)$'
  [[ "$url" =~ $re ]] || { printf '%s\n' "$url"; return; }
  local scheme="${BASH_REMATCH[1]}" p="${BASH_REMATCH[4]}" rest="${BASH_REMATCH[5]}" cip
  if [[ -z "$p" ]]; then
    if [[ "$scheme" =~ ^[hH][tT][tT][pP][sS]$ ]]; then p=443; else p=80; fi  # no ${,,}: macOS bash 3.2
  fi
  if published_on_host "$p"; then printf '%s\n' "$url"; return; fi
  cip="$(container_ip)"
  listens_wide "$p" "$cip" || ensure_forward "$p" "$cip"
  printf '%s://%s:%s%s\n' "$scheme" "$cip" "$p" "$rest"
}

container_open() {
  [[ $# -eq 1 ]] || die "usage: hostchrome open <url>"
  container_status >/dev/null || die "the agent Chrome is not reachable — run 'hostchrome' on the host first"
  local u ip id
  u="$(reach_url "$1")"
  ip="$(host_ip)"
  id="$(curl -fsS -m 5 -X PUT "http://$ip:$port/json/new?$u" | sed -nE 's/.*"id": *"([^"]+)".*/\1/p' | head -1)" ||
    die "could not open $u in the agent Chrome"
  [[ -n "$id" ]] && curl -fsS -m 3 "http://$ip:$port/json/activate/$id" >/dev/null 2>&1 || true
  echo "hostchrome: opened $u in the agent Chrome"
}

container_unforward() {
  local f n
  for f in "$state_dir"/fwd-*.pid; do
    [[ -e "$f" ]] || continue
    if relay_alive "$f"; then kill "$(cat "$f")" && { n="${f##*/fwd-}"; echo "hostchrome: forward ${n%.pid} stopped"; }; fi
    rm -f "$f"
  done
}

# $BROWSER entry point. ~/.local/bin/roe-browser-open is a symlink to this script and
# shadows the shared /usr/local/bin/roe-browser-open, so every tool that "opens a
# browser" (lavish, impeccable, gh --web, …) lands in the host Chrome instead of a
# Herdr pane.
browser_open() {
  local url="${1:-}" real="${HOSTCHROME_REAL_BROWSER_OPEN:-/usr/local/bin/roe-browser-open}"
  [[ -x "$real" ]] || die "$real is missing"
  # Sandboxed/unattended agents keep the shared behaviour (they normally carry their own $BROWSER).
  if [[ -n "${FM_TASK_ID:-}${NONO_CAP_FILE:-}" ]]; then exec "$real" "$@"; fi
  fallback() {
    echo "hostchrome: $1 — using the in-container browser without a Herdr pane (host viewer bookmark)" >&2
    exec env -u HERDR_WORKSPACE_ID -u HERDR_PANE_ID "$real" "$url"
  }
  # A CLI login whose callback is the container's loopback must finish in here:
  # the redirect is signed, so it cannot be rewritten to the container IP.
  if printf '%s' "$url" | grep -qiE 'redirect_uri=https?(%3A|:)(%2F|/){2}(localhost|127\.0\.0\.1|\[::1\]|%5B%3A%3A1%5D)'; then
    fallback "login callback targets the container"
  fi
  container_status >/dev/null 2>&1 || fallback "host Chrome not reachable (run 'hostchrome' on the host)"
  container_open "$url"
}

container_axi() {
  command -v chrome-devtools-axi >/dev/null || die "chrome-devtools-axi is not on PATH"
  container_status >/dev/null || die "the agent Chrome is not reachable — run 'hostchrome' on the host first"
  if [[ "${1:-}" == open || "${1:-}" == newpage ]] && [[ -n "${2:-}" ]]; then
    set -- "$1" "$(reach_url "$2")" "${@:3}"
  fi
  CHROME_DEVTOOLS_AXI_SESSION="${CHROME_DEVTOOLS_AXI_SESSION:-host}" \
  CHROME_DEVTOOLS_AXI_BROWSER_URL="$(cdp_url)" \
    exec chrome-devtools-axi "$@"
}

# --- dispatch ----------------------------------------------------------------
if [[ "$(basename "$0")" == roe-browser-open ]]; then browser_open "$@"; exit; fi

cmd="${1:-}"
if [[ $# -gt 0 ]]; then shift; fi

case "$(side)" in
  mac)
    case "$cmd" in
      ""|start) mac_start "${1:-}" ;;
      stop)     stop_chrome ;;
      status)   host_status ;;
      *)        die "on the Mac: hostchrome [start [url]] | stop | status" ;;
    esac ;;
  linux)
    case "$cmd" in
      ""|start) linux_start "${1:-}" ;;
      stop)     stop_chrome; stop_relays ;;
      status)   host_status ;;
      firewall) linux_firewall ;;
      *)        die "on the Linux host: hostchrome [start [url]] | stop | status | firewall" ;;
    esac ;;
  container)
    case "$cmd" in
      ""|status) container_status ;;
      url)       cdp_url ;;
      open)      container_open "$@" ;;
      axi)       container_axi "$@" ;;
      stop)      container_unforward ;;
      *)         die "in the container: hostchrome status | url | open <url> | axi <chrome-devtools-axi args> | stop" ;;
    esac ;;
  *) die "HOSTCHROME_SIDE must be mac, linux or container" ;;
esac
