#!/usr/bin/env python3
"""Personal RoE routing and whole-stack reservations; stdlib only, Unix hosts."""
import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import signal
import subprocess
import sys
import threading
import time

SETTINGS = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'roe-coordination/config.json'
# Read-only/local tooling targets. Unknown goals require the runtime deliberately.
READ = set('help help-all doctor usage-show usage-flush git-status git-branches pr-status pr-merged worktree-status autoload-check wt-config test-tooling lint-workflows check-env-duplicates check-sns-endpoints codegraph-status codegraph-query codegraph-path codegraph-affected codegraph-explain release-status staging-drift logs logs-api logs-sso logs-pms logs-production-core logs-frontend port-forward-status aws-status break-glass-status'.split())


def fail(message):
    raise RuntimeError(message)


def read(path):
    return json.loads(Path(path).read_text())


def write(path, data):
    path = Path(path)
    tmp = path.with_name(path.name + '.' + secrets.token_hex(6))
    try:
        with tmp.open('x') as stream:
            os.chmod(tmp, 0o600)
            json.dump(data, stream, indent=2)
            stream.write('\n')
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


def config(path=None):
    c = read(path or read(SETTINGS)['config'])
    if c.get('version') != 1 or not Path(c['root']).is_dir():
        fail('Invalid runtime configuration')
    return c


@contextmanager
def locked(c):
    state = Path(c['state'])
    state.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (state / 'mutex').open('a') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        yield state


def lease(state):
    p = state / 'lease.json'
    return read(p) if p.exists() else None


def event(state, action, item):
    # Never log commands, token values or environment variables.
    with (state / 'events.jsonl').open('a') as stream:
        stream.write(json.dumps(dict(time=time.time(), action=action, id=item['id'], task=item['task'])) + '\n')


def owner(item):
    return f"{item['task']} ({item['home']}), reservation {item['id']}"


def digest(token):
    return hashlib.sha256(token.encode()).hexdigest()


def check(c):
    with locked(c) as state:
        item = lease(state)
        token = os.environ.get('ROE_RUNTIME_TOKEN', '')
        if not item or not token or not secrets.compare_digest(item['token_hash'], digest(token)):
            fail('Runtime reserved by ' + owner(item) if item else 'Shared runtime requires a Firstmate reservation. Use roe-coordination run for a registered task.')
        if time.time() - item['heartbeat'] > 30:
            fail('Runtime reservation heartbeat is stale; reconcile with roe-coordination status/recover.')


def task(c, home, ident):
    home = str(Path(home).resolve())
    if home not in c['homes'] or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]*', ident):
        fail('Use an explicitly registered Firstmate home and task ID')
    meta = Path(home) / 'state' / (ident + '.meta')
    fields = dict(line.split('=', 1) for line in meta.read_text().splitlines() if '=' in line)
    if fields.get('kind') not in ('ship', 'scout', 'secondmate') or not Path(fields.get('worktree', '/nonexistent')).is_dir():
        fail('Task metadata must identify an existing registered worktree')
    if not (Path(home) / 'data' / ident / 'brief.md').is_file():
        fail('Registered task brief is missing')
    return home


def staged(c):
    return list((Path(c['root']) / '.staged-worktrees').glob('*.lock'))


def staged_summary(c):
    result = []
    for path in staged(c):
        try:
            fields = dict(line.split('=', 1) for line in path.read_text().splitlines() if '=' in line)
            result.append(dict(repo=path.stem, branch=fields.get('branch', 'legacy'), sha=fields.get('sha', 'unknown')))
        except FileNotFoundError:
            continue
    return result


def run(c, args):
    home = task(c, args.home, args.task)
    command = args.command[1:] if args.command[:1] == ['--'] else args.command
    if not command:
        fail('run requires a command after --')
    token = secrets.token_urlsafe(32)
    item = dict(id=secrets.token_hex(8), home=home, task=args.task, pid=os.getpid(),
                acquired=time.time(), heartbeat=time.time(), token_hash=digest(token))
    with locked(c) as state:
        current = lease(state)
        if current:
            if not args.recover_id or current['id'] != args.recover_id or current['home'] != home or current['task'] != args.task:
                fail('Runtime already reserved by ' + owner(current) + '. Wait or reconcile; never steal it.')
            if not args.processes_stopped_and_state_reviewed:
                fail('Recovery requires explicit confirmation that processes stopped and state was reviewed')
            try:
                os.kill(current['pid'], 0)
            except ProcessLookupError:
                pass
            else:
                fail('Reservation runner is still alive')
        elif args.recover_id:
            fail('Recovery reservation no longer exists')
        if staged(c) and not current:
            fail('Existing staging records require reconciliation before acquiring the runtime')
        write(state / 'lease.json', item)
        event(state, 'acquired', item)
    stop = threading.Event()
    def heartbeat():
        while not stop.wait(5):
            with locked(c) as state:
                current = lease(state)
                if not current or current['id'] != item['id']:
                    return
                current['heartbeat'] = time.time()
                current['staged'] = staged_summary(c)
                write(state / 'lease.json', current)
    thread = threading.Thread(target=heartbeat, daemon=True)
    thread.start()
    child = None
    interrupted = False
    def forward(signum, _frame):
        nonlocal interrupted
        interrupted = True
        if child is not None:
            child.send_signal(signum)
    previous = {sig: signal.signal(sig, forward) for sig in (signal.SIGINT, signal.SIGTERM)}
    rc = 1
    try:
        env = dict(os.environ, ROE_RUNTIME_TOKEN=token)
        child = subprocess.Popen(command, env=env)
        rc = child.wait()
    finally:
        stop.set()
        thread.join()
        for sig, handler in previous.items():
            signal.signal(sig, handler)
        with locked(c) as state:
            current = lease(state)
            if current and current['id'] == item['id']:
                if rc == 0 and not interrupted and not staged(c):
                    event(state, 'released', item)
                    (state / 'lease.json').unlink()
                else:
                    event(state, 'retained', item)
                    print('Reservation retained after failure/interruption or remaining staged code: ' + owner(item) + '. Inspect before recovery.', file=sys.stderr)
                    if rc == 0:
                        rc = 1
    return rc if rc >= 0 else 128 - rc


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='action', required=True)
    g = sub.add_parser('guard'); g.add_argument('config'); g.add_argument('operation'); g.add_argument('goals', nargs='*')
    sub.add_parser('status')
    r = sub.add_parser('run'); r.add_argument('--home', required=True); r.add_argument('--task', required=True); r.add_argument('--recover-id'); r.add_argument('--processes-stopped-and-state-reviewed', action='store_true'); r.add_argument('command', nargs=argparse.REMAINDER)
    r = sub.add_parser('recover'); r.add_argument('--confirm-id', required=True); r.add_argument('--reason', required=True); r.add_argument('--processes-stopped-and-state-reviewed', action='store_true', required=True)
    args = parser.parse_args()
    c = config(args.config if args.action == 'guard' else None)
    if args.action == 'guard':
        if args.operation == 'make' and (not args.goals or all(x in READ for x in args.goals)):
            return 0
        if args.operation == 'stage-worktree' and args.goals == ['status']:
            return 0
        check(c)
        return 0
    if args.action == 'run':
        return run(c, args)
    if args.action == 'recover':
        with locked(c) as state:
            item = lease(state)
            if not item or item['id'] != args.confirm_id or not args.reason.strip():
                fail('Recovery requires the exact current reservation ID and a reason')
            try:
                os.kill(item['pid'], 0)
            except ProcessLookupError:
                pass
            else:
                fail('Reservation runner is still alive; it must finish before recovery')
            if staged(c):
                fail('Staging records remain: restore under the existing reservation using run --recover-id (see documentation)')
            event(state, 'recovered', item)
            (state / 'lease.json').unlink()
        return 0
    with locked(c) as state:
        item = lease(state)
        print('Runtime: ' + (owner(item) if item else 'available (reservation required for runtime operations)'))
        if item:
            print('Heartbeat age: %.0fs' % (time.time() - item['heartbeat']))
        for record in staged_summary(c):
            print('Staged: {repo} {branch} @ {sha}'.format(**record))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, OSError, ValueError, KeyError) as error:
        sys.exit('roe-coordination: ' + str(error))
