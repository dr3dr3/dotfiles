# --- Host state written into the repo via the folded stow symlinks -----------
# These packages are stowed as folded symlinks, so anything the tool writes into
# its config dir lands in this repo. All host state, never config.

# fish writes machine-local universal variables here on every run.
.dotfiles/fish/.config/fish/fish_variables

# nushell history. Kept as a precaution only — on macOS nushell writes history
# to its DATA dir ("~/Library/Application Support/nushell/history.txt"), well
# outside this repo, so neither of these has ever been created here. They would
# apply if nushell's data dir were ever colocated with its config dir (as on
# Linux under XDG, where the container install puts both under ~/.config and
# ~/.local/share respectively). Harmless to keep; do not read them as evidence
# that nushell writes into the stowed dir.
.dotfiles/nushell/.config/nushell/history.txt
.dotfiles/nushell/.config/nushell/history.sqlite3

# OrbStack drops completion symlinks here (docker/kubectl/orbctl), each pointing
# at an absolute path inside /Applications/OrbStack.app. Regenerated on install;
# committing them would push broken links to other machines.
.dotfiles/fish/.config/fish/completions/

# --- Python bytecode ---------------------------------------------------------
# Build artefacts, regenerated on every test run. Six of these were committed in
# #28, and tracked .pyc files are worse than untidy here: running `python3 -m
# unittest discover -s tests` REWRITES them, so the working tree is dirty
# immediately afterwards. That trips doctor-mac.sh's clean-tree assertion on
# every run, and `pi-batch` refuses to start against a dirty tree at all — so
# the overnight agent loop could not run while these were tracked.
# The bare pattern matches at every level, not just the root.
__pycache__/
*.pyc

# --- macOS ------------------------------------------------------------------
# Finder metadata. Written into any directory Finder browses (including this
# repo, and into stowed folders via the folded symlinks), never useful in
# version control. The bare pattern matches at every level, not just the root.
.DS_Store
